+def setLED(M,item,fraction):
+    #Sets an LED (or the UV LED) to a fraction (0-1) of its full-scale current.
+    #ANALOGUE mode: writes a DC set-point voltage to the LED's DAC channel; the CCR stage regulates the current. No PWM.
+    #PWM mode: original behaviour, kept so the same software can drive the digital boards.
+    global sysItems
+    fraction=min(max(float(fraction),0.0),1.0)
+    if LED_DRIVE_MODE=='PWM':
+        setPWM(M,'PWM',sysItems[item],fraction,0)
+        return
+    dacName,channel=LED_DAC_MAP[item]
+    maxCode=(1<<LED_DAC_BITS)-1
+    if fraction<=0.0:
+        code=0 #Off is always exactly zero-scale; the offset below only applies while ON.
+    else:
+        code=int(fraction*LED_DAC_FULLSCALE[item]*maxCode+0.5)+LED_DAC_OFFSET_CODES[item]
+        code=min(max(code,0),maxCode)
+    writeLEDDAC(M,dacName,channel,code)
+
+
+def writeLEDDAC(M,dacName,channel,code):
+    #DAC7578-style write: command byte 0x30|channel = "write to and update channel", then 16 bits with the 12-bit code left-justified.
+    shifted=code<<(16-LED_DAC_BITS)
+    I2CCom(M,dacName,0,24,0x30|(channel&0x07),[(shifted>>8)&0xFF,shifted&0xFF],0)
+
+
+def setAllLEDsZero(M):
+    #Drives every LED DAC channel to zero-scale (all LED current off).
+    if LED_DRIVE_MODE=='PWM':
+        return
+    for item in LED_DAC_MAP:
+        dacName,channel=LED_DAC_MAP[item]
+        writeLEDDAC(M,dacName,channel,0)
+
+
